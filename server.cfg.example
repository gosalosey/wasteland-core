# Wasteland Core - example server.cfg fragment (Milestone 2)
# Merge into your server.cfg. Do not put secrets in files you commit or share.

# --- game build ---
# 3570 (mp2025_01, Money Fronts) is the build the framework is tested on.
# 3751 (mp2025_02) showed missing map parts on the owner's server (2026-10).
sv_enforceGameBuild 3570

# --- database (see docs/DATABASE.md) ---
set mysql_connection_string "mysql://wasteland:PASSWORD@127.0.0.1/wasteland?charset=utf8mb4"
ensure oxmysql
## Voice chat (pma-voice): players near you hear you. F11 changes how far
## (whisper / normal / shout). Caps Lock talks on your group's radio (/group).
setr voice_useNativeAudio true
setr voice_useSendingRangeOnly true
setr voice_defaultCycle "F11"
setr voice_defaultRadio "CAPITAL"
setr voice_enableRadioAnim 1
ensure pma-voice

# --- map (standard; install from github.com/SparksScripts/Total-Apocalypse) ---
## Map: Total Apocalypse (GPL-3.0, github.com/SparksScripts/Total-Apocalypse).
## Comment these four lines out to play on the normal GTA map.
ensure pack1
ensure pack2
ensure pack3
ensure postapo-interior

# --- framework (order matters) ---
ensure wasteland_loadscreen
ensure wasteland_config
ensure wasteland_core
ensure wasteland_database
ensure wasteland_players
ensure wasteland_ui
ensure wasteland_target
ensure wasteland_appearance
ensure wasteland_images
ensure wasteland_inventory
ensure wasteland_survival
ensure wasteland_world
ensure wasteland_admin
ensure wasteland_weapons
ensure wasteland_zombiemodels
ensure wasteland_zombiesounds
ensure wasteland_zombies
ensure wasteland_loot
ensure wasteland_camps
ensure wasteland_crafting
ensure wasteland_quests
ensure wasteland_vehicles
ensure wasteland_emotes
ensure wasteland_tailor
ensure wasteland_supplydrops
ensure wasteland_events
ensure wasteland_groups
ensure wasteland_trade
ensure wasteland_hunting
ensure wasteland_skills
ensure wasteland_guide
ensure wasteland_props
# Base building uses the free wasteland_buildprops models. (Own the paid
# sinor-buildingProps-v2 pack instead? See basebuilding.lua propsResource.)
ensure wasteland_buildprops
ensure wasteland_basebuilding
ensure wasteland_template      # SDK example module; optional

# --- permissions ---
add_ace group.admin wasteland.admin allow
# add_principal identifier.license:<your-license> group.admin

# --- optional: use a differently named config resource ---
# set wasteland_config_resource "my_wasteland_config"
