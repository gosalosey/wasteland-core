# Wasteland Core - example server.cfg fragment (Milestone 2)
# Merge into your server.cfg. Do not put secrets in files you commit or share.

# --- game build ---
# 3570 (mp2025_01, Money Fronts) is the build the framework is tested on.
# 3751 (mp2025_02) showed missing map parts on the owner's server (2026-10).
sv_enforceGameBuild 3570

# --- database (see docs/DATABASE.md) ---
set mysql_connection_string "mysql://wasteland:PASSWORD@127.0.0.1/wasteland?charset=utf8mb4"
ensure oxmysql

# --- framework (order matters) ---
ensure wasteland_config
ensure wasteland_core
ensure wasteland_database
ensure wasteland_players
ensure wasteland_ui
ensure wasteland_target
ensure wasteland_appearance
ensure wasteland_images
ensure wasteland_inventory
ensure wasteland_survival
ensure wasteland_world
ensure wasteland_admin
ensure wasteland_weapons
ensure wasteland_zombies
ensure wasteland_loot
ensure wasteland_template      # SDK example module; optional

# --- permissions ---
add_ace group.admin wasteland.admin allow
# add_principal identifier.license:<your-license> group.admin

# --- optional: use a differently named config resource ---
# set wasteland_config_resource "my_wasteland_config"
